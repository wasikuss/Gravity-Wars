// ----------------------------------------------------------------------------------------------------
// -- Code related to keyboard interactions
// ----------------------------------------------------------------------------------------------------
import types.{Game}
import shoot.{explode, playerPressedShootButton}
import logic.{newGame}

fn love_keypressed(game: &mut Game, key: String) {
    print(key)

    let player = if game.turn == 1 {
        &mut game.player1
    } else {
        &mut game.player2
    }

    if key == "right" {
        game.keyRight = true
        player.angle = player.angle + 1.0
    }

    if key == "left" {
        game.keyLeft = true
        player.angle = player.angle - 1.0
    }

    if key == "up" {
        game.keyUp = true

        player.force = player.force * 1.01
    }

    if key == "down" {
        game.keyDown = true

        player.force = player.force * 0.99
    }

    if key == "x" {
        explode(game, 400.0, 300.0)
    }

    if key == "n" {
        newGame(game)
    }

    if key == "space" {
        playerPressedShootButton(game)
    }

    if key == "escape" {
        quit()
    }
}

fn love_keyreleased(game: &mut Game, key: String) {
    game.keyRight = false
    game.keyLeft = false
    game.keyUp = false
    game.keyDown = false
}
